{
  "name": "xanima-core",
  "version": "0.6.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema/xanima-soul-1.schema.json": "./schema/xanima-soul-1.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "~12.11.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  },
  "description": "Xanima core: the agent continuity engine behind the xanima MCP server, xanima-server and the xanima-openclaw plugin. Graph store with belief metadata (confidence, provenance, supersession, as-of time travel), FSRS-6 forgetting curve, spreading activation, sleep-style consolidation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Enlightened-Republic/xanima.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "schema/*.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
