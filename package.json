{
  "name": "sharpwave",
  "version": "0.1.1",
  "description": "Long-term memory for AI agents. An MCP server that remembers across sessions, forgets what stops mattering, and consolidates the rest — modeled on how the hippocampus actually works.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sharpwave": "dist/index.js"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai-memory",
    "agent-memory",
    "long-term-memory",
    "claude",
    "claude-code",
    "cursor",
    "llm",
    "knowledge-graph",
    "spaced-repetition",
    "fsrs",
    "vector-search",
    "sqlite"
  ],
  "author": "Enlightened Republic",
  "license": "MIT",
  "homepage": "https://github.com/EnlightenedRepublic/sharpwave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnlightenedRepublic/sharpwave.git"
  },
  "bugs": {
    "url": "https://github.com/EnlightenedRepublic/sharpwave/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "~12.11.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
